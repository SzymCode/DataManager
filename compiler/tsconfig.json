{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022"],
    "strict": true,
    "noEmit": true,
    "jsx": "preserve",
    "jsxImportSource": "react",
    "types": ["node"],
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": {
      "#nuc-compiler/runtime": ["./runtime/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "runtime/**/*.ts",
    "tests/**/*.ts",
    "fixtures/**/*.nuc.tsx",
    "vitest.config.ts"
  ]
}
