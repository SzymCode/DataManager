{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"jsx": "preserve",
		"sourceMap": true,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"lib": ["ESNext", "DOM"],
		"skipLibCheck": true,
		"types": ["vite/client"],
		"baseUrl": ".",
		"paths": {
			"vue": ["node_modules/vue"],
			"vue-i18n": ["node_modules/vue-i18n"],
			"h3": ["node_modules/h3"],
			"nitropack/runtime": ["node_modules/nitropack/runtime"],
			"nuxt/app": ["node_modules/nuxt/dist/app"],
			"nuxt/*": ["node_modules/nuxt/*"],
			"#imports": [".nuxt/imports.d.ts"],
			"nucleify": ["src/nucleify.ts"],
			"nuc_api": ["../shared_modules/nuc_api/supabase/api/server.ts"],
			"nuc_client": ["src/nuc_client.ts"],
			"nuc_server": ["src/server/nuc_server.ts"],
			"modules": ["../shared_modules"],
			"modules/*": ["../shared_modules/*"],
			"portable/nui": ["../portable/nui/index.ts"],
			"portable/nui/*": ["../portable/nui/*"],
			"#nuc-compiler/runtime": ["../compiler/runtime/index.ts"],
			"~/*": ["src/*"]
		}
	},
	"include": [
		"./**/*.d.ts",
		"./**/*.ts",
		"./**/*.tsx",
		"./**/*.vue",
		"./**/*.js",
		"./**/*.jsx",
		"../shared_modules/**/*.ts",
		"../shared_modules/**/*.vue",
		"../portable/nui/**/*.ts"
	],
	"exclude": [
		"../node_modules",
		"./node_modules",
		"./.nuxt",
		"../dist",
		"../vendor",
		"./vitest.config.ts",
		"../shared_modules/nuc_stores/**",
		"../shared_modules/**/*.tsx",
		"../shared_modules/**/*.react.ts",
		"../shared_modules/**/index.react.ts",
		"../shared_modules/**/supabase/functions/**",
		"**/*.nuc.tsx",
		"../**/*.stories.ts",
		"../**/*.stories.tsx",
		"../**/*.spec.ts",
		"../**/*.spec.tsx",
		"../**/*.test.ts",
		"../**/*.test.tsx",
		"./**/*.spec.ts",
		"./**/*.test.ts"
	]
}
