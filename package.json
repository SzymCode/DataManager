{
  "name": "nucleify",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -s --filter @nucleify/web dev",
    "build": "pnpm -s --filter @nucleify/web build",
    "start": "pnpm -s --filter @nucleify/web start",
    "generate": "pnpm -s --filter @nucleify/web generate",
    "preview": "pnpm -s --filter @nucleify/web preview",
    "prepare": "pnpm -s --filter @nucleify/web prepare && pnpm sync-rules",
    "admin": "pnpm -s --filter @nucleify/admin dev",
    "docs": "pnpm -s --filter @nucleify/docs dev",
    "compiler": "tsx compiler/src/cli.ts",
    "compiler:scaffold": "tsx compiler/src/cli.ts scaffold",
    "compiler:build": "tsx compiler/src/cli.ts build",
    "compiler:build:vue": "tsx compiler/src/cli.ts build --target=vue",
    "compiler:build:react": "tsx compiler/src/cli.ts build --target=react",
    "compiler:check": "tsx compiler/src/cli.ts check",
    "compiler:test": "vitest run --config .config/vitest.compiler.config.ts",
    "sync-rules": "node .config/scripts/sync-rules.js",
    "prepare:husky": "husky",
    "prepare:submodules": "sh .config/bash/prepare-submodules.sh",
    "btest": "node .config/scripts/run-check.js btest bash .config/bash/tests/run.sh",
    "check": "node .config/scripts/run-check.js biome biome check .",
    "write": "node .config/scripts/run-check.js biome biome check --write .",
    "typeslint": "node .config/scripts/run-check.js typeslint tsc --noEmit -p web/tsconfig.json",
    "slint": "node .config/scripts/run-check.js stylelint stylelint \"web/**/*.scss\" \"shared_modules/**/*.scss\" \"portable/**/*.scss\"",
    "slint:fix": "node .config/scripts/run-check.js stylelint stylelint \"web/**/*.scss\" \"shared_modules/**/*.scss\" \"portable/**/*.scss\" --fix",
    "tests": "node .config/scripts/run-check.js vitest vitest run",
    "test:watch": "vitest",
    "test:shared": "node .config/scripts/run-check.js vitest vitest run --project shared",
    "test:web": "node .config/scripts/run-check.js vitest vitest run --project web",
    "supabase:merge-sql": "bash .config/bash/merge-module-supabase-sql.sh all",
    "supabase:factories:apply:local": "bash .config/bash/apply-module-sql.sh factories local",
    "supabase:factories:apply:linked": "bash .config/bash/apply-module-sql.sh factories linked",
    "supabase:seeders:apply:local": "pnpm supabase:factories:apply:local && bash .config/bash/apply-module-sql.sh seeders local",
    "supabase:seeders:apply:linked": "pnpm supabase:factories:apply:linked && bash .config/bash/apply-module-sql.sh seeders linked",
    "supabase:migrations:apply:local": "bash .config/bash/apply-module-migrations.sh local",
    "supabase:migrations:apply:linked": "bash .config/bash/apply-module-migrations.sh linked",
    "supabase:setup:local": "pnpm supabase:migrations:apply:local && pnpm supabase:factories:apply:local && pnpm supabase:seeders:apply:local",
    "supabase:setup:linked": "pnpm supabase:migrations:apply:linked && pnpm supabase:factories:apply:linked && pnpm supabase:seeders:apply:linked",
    "wrangler": "pnpm -s --filter @nucleify/web exec wrangler deploy"
  },
  "imports": {
    "#nuc-compiler/runtime": "./compiler/runtime/index.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@nuxt/test-utils": "3.23.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@vue/compiler-dom": "^3.5.41",
    "@vue/compiler-sfc": "^3.5.41",
    "@vue/test-utils": "2.4.6",
    "citty": "^0.1.6",
    "happy-dom": "20.0.10",
    "husky": "9.1.7",
    "jsdom": "29.0.2",
    "next": "^16.2.12",
    "oxc-parser": "^0.75.0",
    "stylelint": "16.26.1",
    "stylelint-config-standard-scss": "14.0.0",
    "tsx": "^4.20.3",
    "typescript": "5.8.3",
    "vitest": "3.2.0",
    "zod": "^3.25.76"
  }
}
